# Copy to .env and fill in. Never commit .env.
# Upload to Cloudflare with:  npx.cmd wrangler secret bulk .env

# Your home's coordinates (decimal degrees).
LATITUDE=
LONGITUDE=

# Govee Home app > Profile > Settings > Apply for API Key.
GOVEE_API_KEY=

# From "npm run devices". Several plugs: separate with commas.
# Example: H5080|AA:BB:CC:DD:EE:FF:00:11
GOVEE_DEVICES=

# Optional: a long random name only you know; subscribe to it in the ntfy phone app.
# Leave empty to use only the Home Screen app's alerts.
NTFY_TOPIC=

# Home Screen app alerts: run  npm run push-keys  to fill these in.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_CODE=
