# Copy to .env for local runs. Never commit .env.
# In GitHub, create these as repository secrets with the same names.

# Your home's coordinates (decimal degrees).
LATITUDE=
LONGITUDE=

# Govee Home app > Profile > Settings > Apply for API Key.
GOVEE_API_KEY=

# From "python -m windguard devices". Several plugs: separate with commas.
# Example: H5080|AA:BB:CC:DD:EE:FF:00:11
GOVEE_DEVICES=

# A long random name only you know; subscribe to it in the ntfy phone app.
NTFY_TOPIC=
